# Federated MCP demo — environment template
#
#     cp .env.example .env
#
# .env is gitignored. setup.sh, demo.sh and teardown.sh source it automatically.

# ── Required: Solo agentgateway license ──────────────────────────────────────
# Either the product-specific key, or a single trial key covering several Solo
# products (AGENTGATEWAY_LICENSE_KEY wins if both are set).
AGENTGATEWAY_LICENSE_KEY=eyJ...
# SOLO_LICENSE_KEY=eyJ...

# ── Optional overrides ───────────────────────────────────────────────────────
# Every variable below already has a sensible default in setup.sh; uncomment
# only what you need to change.

# CLUSTER_NAME=mcp-federation          # k3d cluster to create/reuse
# AGW_VERSION=v2026.8.0                # Solo Enterprise agentgateway chart + CRDs
# GATEWAY_API_VERSION=v1.5.0           # upstream Gateway API CRDs
# AGW_NS=agentgateway-system           # where agentgateway is installed
# DEMO_NS=mcp-federation               # everything this demo owns

# ── Script endpoints ─────────────────────────────────────────────────────────
# Defaults match ./port-forward.sh. Change these to point the scripts at an
# ingress or a real hostname instead of port-forwards.
# GATEWAY_URL=http://localhost:8080
# KEYCLOAK_URL=http://localhost:8081
# PROMETHEUS_URL=http://localhost:9090

# Companies scripts/mcp.py knows about. Extend this after onboarding a partner
# so `scripts/mcp.py matrix` includes them.
# COMPANIES=acme,globex,initech
