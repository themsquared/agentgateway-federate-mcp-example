{
  "realm": "globex",
  "displayName": "Globex Industries",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 3600,
  "clients": [
    {
      "clientId": "globex-agent",
      "name": "Globex MCP Agent",
      "enabled": true,
      "publicClient": false,
      "secret": "globex-secret",
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "protocolMappers": [
        {
          "name": "company",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "company",
            "claim.value": "globex",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "tier",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "tier",
            "claim.value": "standard",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "mcp-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "mcp-federation",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@globex.example.com",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Okafor",
      "credentials": [
        {
          "type": "password",
          "value": "bob",
          "temporary": false
        }
      ]
    }
  ]
}
